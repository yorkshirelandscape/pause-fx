{
  "id": "pause-fx",
  "title": "Pause FX",
  "description": "Declarative, reusable themed pause-screen reveals -- border/icon/text/video/image/audio steps on cycle-based clocks, plus closing every connected client's open windows via socketlib.",
  "version": "1.1.0",
  "manifest": "https://github.com/yorkshirelandscape/pause-fx/releases/latest/download/module.json",
  "url": "https://github.com/yorkshirelandscape/pause-fx",
  "download": "https://github.com/yorkshirelandscape/pause-fx/releases/latest/download/pause-fx.zip",
  "readme": "https://raw.githubusercontent.com/yorkshirelandscape/pause-fx/main/README.md",
  "bugs": "https://github.com/yorkshirelandscape/pause-fx/issues",
  "changelog": "https://raw.githubusercontent.com/yorkshirelandscape/pause-fx/main/CHANGELOG.md",
  "socket": true,
  "authors": [
    {
      "name": "volfied",
      "email": "andrew.bryce.howard@gmail.com",
      "url": "https://www.volfied.net",
      "discord": "volfied"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "esmodules": [
    "scripts/pause-fx.js",
    "scripts/composer.js"
  ],
  "styles": [
    "styles/composer.css"
  ],
  "packs": [
    {
      "name": "macros",
      "label": "Pause FX Macros",
      "path": "packs/macros",
      "type": "Macro",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      },
      "flags": {}
    }
  ],
  "relationships": {
    "requires": [
      {
        "id": "socketlib",
        "type": "module",
        "manifest": "https://github.com/manuelVo/foundryvtt-socketlib/releases/latest/download/module.json"
      }
    ]
  }
}
