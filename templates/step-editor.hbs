<div class="pfx-step-editor">
  <div class="pfx-block-toggles">
    {{#each blocks as |b|}}
    <button type="button" data-action="toggleBlock" data-block="{{b.key}}"
            class="pfx-block-toggle {{#if b.visible}}pfx-block-toggle-active{{/if}}" title="{{b.label}}">
      <i class="{{b.style}} {{b.icon}}"></i>
    </button>
    {{/each}}
  </div>

  {{#if visible.wait}}
  <fieldset class="pfx-block">
    <legend><i class="fa-solid fa-hourglass-half"></i> Timer</legend>
    <div class="pfx-row">
      <label class="pfx-field pfx-field-narrow">Pulses <input type="number" step="0.05" min="0" name="waitUnits" value="{{row.waitUnits}}"></label>
    </div>
  </fieldset>
  {{/if}}

  {{#if visible.text}}
  <fieldset class="pfx-block">
    <legend><i class="fa-solid fa-font"></i> Text</legend>
    <div class="pfx-row">
      <div class="pfx-field">
        <span class="pfx-field-label-row">
          <span>Message</span>
          <span class="pfx-checkbox-group">
            <label class="pfx-checkbox"><input type="checkbox" name="textNone" data-disables="text" {{checked row.textNone}}> None</label>
            <label class="pfx-checkbox"><input type="checkbox" name="textPulse" {{checked row.textPulse}}> Pulse</label>
          </span>
        </span>
        <input type="search" name="text" value="{{row.text}}" {{#if row.textNone}}disabled{{/if}}>
      </div>
    </div>
  </fieldset>
  {{/if}}

  {{#if visible.icon}}
  <fieldset class="pfx-block">
    <legend><i class="fa-solid fa-star"></i> Icon</legend>
    <div class="pfx-row">
      <label class="pfx-field">Icon
        <span class="pfx-with-picker">
          <input type="text" name="icon" placeholder="ui/pause.svg" value="{{row.icon}}">
          <button type="button" data-action="browseFile" data-for="icon" data-picker-type="imagevideo">
            <i class="fa-solid fa-folder-open"></i>
          </button>
        </span>
      </label>
    </div>
    <div class="pfx-row">
      <label class="pfx-checkbox"><input type="checkbox" name="iconSpin" {{checked row.iconSpin}}> Spin</label>
    </div>
    <div class="pfx-row">
      <span class="pfx-with-toggle" title="Icon Glow">
        <input type="checkbox" name="iconGlowEnabled" data-enables="iconGlow" {{checked row.iconGlowEnabled}}>
        <input type="color" name="iconGlow" value="{{row.iconGlow}}" {{#unless row.iconGlowEnabled}}disabled{{/unless}}>
      </span>
    </div>
  </fieldset>
  {{/if}}

  {{#if visible.border}}
  <fieldset class="pfx-block">
    <legend><i class="fa-regular fa-square"></i> Border</legend>
    <div class="pfx-row">
      <label class="pfx-field pfx-field-narrow">Width % <input type="number" step="5" min="-100" placeholder="0" name="borderWidthPct" value="{{row.borderWidthPct}}"></label>
      <span class="pfx-with-toggle">
        <input type="checkbox" name="borderColorEnabled" data-enables="borderColor" {{checked row.borderColorEnabled}}>
        <input type="color" name="borderColor" value="{{row.borderColor}}" {{#unless row.borderColorEnabled}}disabled{{/unless}}>
      </span>
    </div>
  </fieldset>
  {{/if}}

  {{#if visible.media}}
  <fieldset class="pfx-block">
    <legend><i class="fa-solid fa-video"></i> Media</legend>
    <div class="pfx-row">
      <label class="pfx-checkbox"><input type="radio" name="mediaType" value="video" {{#if (eq row.mediaType "video")}}checked{{/if}}> Video</label>
      <label class="pfx-checkbox"><input type="radio" name="mediaType" value="image" {{#if (eq row.mediaType "image")}}checked{{/if}}> Image</label>
    </div>
    <div class="pfx-row" data-media-show="video">
      <label class="pfx-field">Volume <range-picker name="videoVolume" min="0" max="1" step="0.1" value="{{row.videoVolume}}"></range-picker></label>
    </div>
    <div class="pfx-row" data-media-show="image">
      <label class="pfx-field pfx-field-narrow">Pulses <input type="number" step="0.05" min="0" name="imagePulses" placeholder="manual" value="{{row.imagePulses}}"></label>
    </div>
    <div class="pfx-row">
      <label class="pfx-field">Path <input type="text" name="mediaPath" value="{{row.mediaPath}}" placeholder="file or folder"></label>
    </div>
    <div class="pfx-row">
      <label class="pfx-checkbox"><input type="checkbox" name="loop" {{checked row.loop}}> Loop</label>
      <label class="pfx-checkbox" data-media-show="video"><input type="checkbox" name="waitForVideoEnd" {{checked row.waitForVideoEnd}}> Timer Waits</label>
    </div>
  </fieldset>
  {{/if}}

  {{#if visible.audio}}
  <fieldset class="pfx-block">
    <legend><i class="fa-solid fa-volume-high"></i> Audio</legend>
    <div class="pfx-row">
      <label class="pfx-field">Path <input type="text" name="audio" value="{{row.audio}}"></label>
      <label class="pfx-field">Volume <range-picker name="audioVolume" min="0" max="1" step="0.1" value="{{row.audioVolume}}"></range-picker></label>
    </div>
    <div class="pfx-row">
      <label class="pfx-checkbox"><input type="checkbox" name="audioLoop" {{checked row.audioLoop}}> Loop</label>
      <label class="pfx-checkbox"><input type="checkbox" name="waitForAudioEnd" {{checked row.waitForAudioEnd}}> Timer Waits</label>
    </div>
  </fieldset>
  {{/if}}

  {{#if visible.stop}}
  <fieldset class="pfx-block">
    <legend><i class="fa-solid fa-circle-stop"></i> Stop</legend>
    <div class="pfx-row">
      <label class="pfx-checkbox"><input type="checkbox" name="closeVideo" {{checked row.closeVideo}}> Video/Image</label>
      <label class="pfx-checkbox"><input type="checkbox" name="stopAudio" {{checked row.stopAudio}}> Audio</label>
      <label class="pfx-checkbox"><input type="checkbox" name="hideIcon" {{checked row.hideIcon}}> Icon</label>
      <label class="pfx-checkbox"><input type="checkbox" name="stopIconSpin" {{checked row.stopIconSpin}}> Icon Spin</label>
      <label class="pfx-checkbox"><input type="checkbox" name="stopTextPulse" {{checked row.stopTextPulse}}> Text Pulse</label>
      <label class="pfx-checkbox"><input type="checkbox" name="stopBorderPulse" {{checked row.stopBorderPulse}}> Border Pulse</label>
      <label class="pfx-checkbox"><input type="checkbox" name="unpause" {{checked row.unpause}}> Unpause</label>
    </div>
  </fieldset>
  {{/if}}
</div>
