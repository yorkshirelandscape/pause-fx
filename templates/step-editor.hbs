<div class="pfx-step-editor">
  <fieldset class="pfx-block pfx-block-stop">
    <legend><i class="fa-duotone fa-circle-stop"></i> Stop</legend>
    <div class="pfx-stop-grid">
      <label class="pfx-checkbox"><input type="checkbox" name="stopAudio" {{checked row.stopAudio}}> Audio</label>
      <label class="pfx-checkbox"><input type="checkbox" name="stopBorderPulse" {{checked row.stopBorderPulse}}> Border Pulse</label>
      <label class="pfx-checkbox"><input type="checkbox" name="stopIconSpin" {{checked row.stopIconSpin}}> Icon Spin</label>
      <label class="pfx-checkbox"><input type="checkbox" name="stopTextFade" {{checked row.stopTextFade}}> Text Fade</label>
      <label class="pfx-checkbox"><input type="checkbox" name="stopTextPulse" {{checked row.stopTextPulse}}> Text Pulse</label>
      <label class="pfx-checkbox pfx-stop-unpause"><input type="checkbox" name="unpause" {{checked row.unpause}}> Unpause</label>
    </div>
  </fieldset>

  <fieldset class="pfx-block pfx-block-wait">
    <legend><i class="fa-solid fa-hourglass-half"></i> Duration</legend>
    <div class="pfx-row">
      <label class="pfx-field pfx-field-narrow" title="No media on this step: plain wait before the next one. Media present: how long it plays.">Beats
        <input type="number" step="0.05" min="0" name="waitUnits" value="{{row.waitUnits}}">
      </label>
      <div class="pfx-av-pair">
        <span class="pfx-field-label pfx-av-header">AV</span>
        <label class="pfx-field-label" for="preAvUnits" title="Delay after media appears, before it starts playing">Pre</label>
        <input id="preAvUnits" class="pfx-field-av" type="number" step="0.1" min="0" name="preAvUnits" placeholder="0" value="{{row.preAvUnits}}">
        <label class="pfx-field-label" for="postAvUnits" title="Delay after media stops, before the next step">Post</label>
        <input id="postAvUnits" class="pfx-field-av" type="number" step="0.1" min="0" name="postAvUnits" placeholder="0" value="{{row.postAvUnits}}">
      </div>
    </div>
  </fieldset>

  <fieldset class="pfx-block pfx-block-text">
    <legend><i class="fa-solid fa-font"></i> Text</legend>
    <div class="pfx-row">
      <label class="pfx-field pfx-field-grow">Message
        <input type="search" name="text" value="{{row.text}}" placeholder="GAME PAUSED" {{#if row.textNone}}disabled{{/if}}>
      </label>
      <label class="pfx-field pfx-field-narrow" title="Pulse/fade speed, as a multiple of Cycle Time">Beats/Cycle
        <input type="number" step="0.1" min="0.1" name="textBeatsPerCycle" placeholder="1" value="{{row.textBeatsPerCycle}}">
      </label>
    </div>
    <div class="pfx-checkbox-group">
      <label class="pfx-checkbox"><input type="checkbox" name="textNone" data-disables="text" {{checked row.textNone}}> None</label>
      <label class="pfx-checkbox" title="Dilate/contract"><input type="checkbox" name="textPulse" {{checked row.textPulse}}> Pulse</label>
      <label class="pfx-checkbox" title="Darken/brighten"><input type="checkbox" name="textFade" {{checked row.textFade}}> Fade</label>
      <span class="pfx-with-toggle" title="Text Glow -- unset, tracks the border color">
        <input type="checkbox" name="textGlowEnabled" data-enables="textGlow" {{checked row.textGlowEnabled}}>
        <input type="color" name="textGlow" value="{{row.textGlow}}" {{#unless row.textGlowEnabled}}disabled{{/unless}}>
      </span>
    </div>
  </fieldset>

  <fieldset class="pfx-block pfx-block-icon">
    <legend><i class="fa-solid fa-star"></i> Icon</legend>
    <div class="pfx-row">
      <label class="pfx-field pfx-field-grow">Path
        <span class="pfx-with-picker">
          <input type="text" name="icon" placeholder="ui/pause.svg" value="{{row.icon}}" {{#if row.iconNone}}disabled{{/if}}>
          <button type="button" data-action="browseFile" data-for="icon" data-picker-type="imagevideo">
            <i class="fa-solid fa-folder-open"></i>
          </button>
        </span>
      </label>
      <label class="pfx-field pfx-field-narrow" title="Spin speed, as a multiple of Cycle Time">Beats/Cycle
        <input type="number" step="0.1" min="0.1" name="iconBeatsPerCycle" placeholder="1" value="{{row.iconBeatsPerCycle}}">
      </label>
    </div>
    <div class="pfx-checkbox-group">
      <label class="pfx-checkbox" title="Defaults to whatever the previous step left it as"><input type="checkbox" name="iconNone" data-disables="icon" {{checked row.iconNone}}> None</label>
      <label class="pfx-checkbox"><input type="checkbox" name="iconSpin" {{checked row.iconSpin}}> Spin</label>
      <span class="pfx-with-toggle" title="Icon Glow">
        <input type="checkbox" name="iconGlowEnabled" data-enables="iconGlow" {{checked row.iconGlowEnabled}}>
        <input type="color" name="iconGlow" value="{{row.iconGlow}}" {{#unless row.iconGlowEnabled}}disabled{{/unless}}>
      </span>
    </div>
  </fieldset>

  <fieldset class="pfx-block pfx-block-border">
    <legend><i class="fa-regular fa-square-full"></i> Border</legend>
    <div class="pfx-row">
      <label class="pfx-field pfx-field-narrow pfx-field-row"><span>Width<br>+/- %</span>
        <input type="number" step="5" min="-100" placeholder="0" name="borderWidthPct" value="{{row.borderWidthPct}}">
      </label>
    </div>
    <div class="pfx-row">
      <label class="pfx-field pfx-field-narrow pfx-field-row" title="Pulse speed, as a multiple of Cycle Time"><span>Beats/<br>Cycle</span>
        <input type="number" step="0.1" min="0.1" name="borderBeatsPerCycle" placeholder="1" value="{{row.borderBeatsPerCycle}}">
      </label>
    </div>
    <div class="pfx-row">
      <span class="pfx-with-toggle">
        <input type="checkbox" name="borderColorEnabled" data-enables="borderColor" {{checked row.borderColorEnabled}}>
        <input type="color" name="borderColor" value="{{row.borderColor}}" {{#unless row.borderColorEnabled}}disabled{{/unless}}>
      </span>
    </div>
  </fieldset>

  <fieldset class="pfx-block pfx-block-media">
    <legend><i class="fa-solid fa-photo-film"></i> Media</legend>
    <div class="pfx-media-io">
      <div class="pfx-row pfx-io-toggle">
        <span class="pfx-media-toggle">
          <i class="fa-solid fa-film"></i>
          <label class="pfx-switch">
            <input type="checkbox" name="mediaType" {{#unless (eq row.mediaType "video")}}checked{{/unless}}>
            <span class="pfx-switch-track"><span class="pfx-switch-thumb"></span></span>
          </label>
          <i class="fa-solid fa-image"></i>
        </span>
      </div>
      <label class="pfx-checkbox pfx-io-loop"><input type="checkbox" name="loop" {{checked row.loop}}> Loop</label>
      <span class="pfx-io-path-label">Path</span>
      <span class="pfx-io-vlabel" data-media-show="video">Volume</span>
      <label class="pfx-field pfx-field-narrow pfx-io-pulses" data-media-show="image">Beats <input type="number" step="0.05" min="0" name="imagePulses" placeholder="manual" value="{{row.imagePulses}}"></label>
      <range-picker class="pfx-io-range" data-media-show="video" name="videoVolume" min="0" max="1" step="0.1" value="{{row.videoVolume}}"></range-picker>
    </div>
    <div class="pfx-row">
      <span class="pfx-with-picker">
        <input type="text" name="mediaPath" value="{{row.mediaPath}}" placeholder="file or folder">
        <button type="button" data-action="browseFile" data-for="mediaPath" data-picker-type="imagevideo">
          <i class="fa-solid fa-folder-open"></i>
        </button>
      </span>
    </div>
  </fieldset>

  <fieldset class="pfx-block pfx-block-audio">
    <legend><i class="fa-solid fa-volume-high"></i> Audio</legend>
    <div class="pfx-media-io">
      <label class="pfx-checkbox pfx-io-toggle" title="Bound: part of this step's own AV timing, stopped with it. Unchecked: starts now, keeps playing until a later step's Stop Audio."><input type="checkbox" name="waitForAudioEnd" {{checked row.waitForAudioEnd}}> Bound</label>
      <label class="pfx-checkbox pfx-io-loop"><input type="checkbox" name="audioLoop" {{checked row.audioLoop}}> Loop</label>
      <span class="pfx-io-path-label">Path</span>
      <span class="pfx-io-vlabel">Volume</span>
      <range-picker class="pfx-io-range" name="audioVolume" min="0" max="1" step="0.1" value="{{row.audioVolume}}"></range-picker>
    </div>
    <div class="pfx-row">
      <span class="pfx-with-picker">
        <input type="text" name="audio" value="{{row.audio}}" placeholder="sound/sting.ogg">
        <button type="button" data-action="browseFile" data-for="audio" data-picker-type="audio">
          <i class="fa-solid fa-folder-open"></i>
        </button>
      </span>
    </div>
  </fieldset>
</div>
