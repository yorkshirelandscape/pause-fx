<div class="pfx-composer">
  <fieldset class="pfx-startup">
    <legend><i class="fa-solid fa-bolt fa-lg"></i> Startup</legend>
    <div class="pfx-row">
      <label class="pfx-field pfx-field-narrow pfx-field-pulse-time">
        <span>Pulse<br>Time</span>
        <input type="number" step="0.01" min="0" name="pulseLengthS" placeholder="5 sec" value="{{globals.pulseLengthS}}">
      </label>
      <label class="pfx-checkbox">End Active Encounter <input type="checkbox" name="endCombat" {{checked globals.endCombat}}></label>
      <span class="pfx-close-windows">
        <span class="pfx-inline-label">Close Windows:</span>
        <label class="pfx-checkbox">Players <input type="checkbox" name="closeWindowsPlayers" {{checked globals.closeWindowsPlayers}}></label>
        <label class="pfx-checkbox">GMs <input type="checkbox" name="closeWindowsGM" {{checked globals.closeWindowsGM}}></label>
      </span>
    </div>
  </fieldset>

  <fieldset class="pfx-steps-fieldset">
    <legend><i class="fa-solid fa-stairs fa-lg"></i> Steps</legend>
    <ol class="pfx-steps">
      {{#each rows as |row|}}
      <li class="pfx-step" data-index="{{row.index}}">
        <i class="pfx-step-handle fa-solid fa-grip-vertical" draggable="true" title="Drag to reorder"></i>
        <button type="button" class="pfx-step-open" data-action="editStep">
          <span class="pfx-step-badges">
            {{#each row.badges as |b|}}
              {{#if (eq b.type "preAV")}}<span class="pfx-badge pfx-badge-wait pfx-badge-preav" title="Pre-AV">{{b.label}}</span>{{/if}}
              {{#if (eq b.type "wait")}}<span class="pfx-badge pfx-badge-wait" title="Wait">{{b.label}}</span>{{/if}}
              {{#if (eq b.type "postAV")}}<span class="pfx-badge pfx-badge-wait pfx-badge-postav" title="Post-AV">{{b.label}}</span>{{/if}}
              {{#if (eq b.type "avType")}}
                <span class="pfx-badge pfx-badge-wait pfx-badge-av-type" title="Duration">
                  {{b.label}}
                  {{#if (eq b.mediaType "video")}}<i class="fa-solid fa-video pfx-badge-av-type-icon"></i>{{/if}}
                  {{#if (eq b.mediaType "image")}}<i class="fa-solid fa-image pfx-badge-av-type-icon"></i>{{/if}}
                  {{#if (eq b.mediaType "audio")}}<i class="fa-solid fa-volume-high pfx-badge-av-type-icon"></i>{{/if}}
                </span>
              {{/if}}
              {{#if (eq b.type "audioBound")}}<i class="fa-solid fa-link pfx-badge" title="Audio bound to this step"></i>{{/if}}
              {{#if (eq b.type "border")}}<span class="pfx-badge pfx-badge-swatch" style="border-color:{{b.colour}}" title="Border: {{b.colour}}"></span>{{/if}}
              {{#if (eq b.type "icon")}}
                <span class="pfx-badge pfx-badge-icon" style="border-color:{{b.glow}}" title="Icon">
                  {{#if b.icon}}<img src="{{b.icon}}" alt="">{{/if}}
                  {{#if b.spin}}<i class="fa-solid fa-rotate pfx-badge-icon-spin"></i>{{/if}}
                  {{#if (eq b.visible true)}}<i class="fa-solid fa-eye pfx-badge-icon-eye"></i>{{/if}}
                  {{#if (eq b.visible false)}}<i class="fa-solid fa-eye-slash pfx-badge-icon-eye"></i>{{/if}}
                </span>
              {{/if}}
              {{#if (eq b.type "video")}}<i class="fa-solid fa-video pfx-badge" title="Video"></i>{{/if}}
              {{#if (eq b.type "image")}}<i class="fa-solid fa-image pfx-badge" title="Image"></i>{{/if}}
              {{#if (eq b.type "audio")}}<i class="fa-solid fa-volume-high pfx-badge" title="Audio"></i>{{/if}}
              {{#if (eq b.type "loop")}}<i class="fa-solid fa-repeat pfx-badge" title="Loop"></i>{{/if}}
              {{#if (eq b.type "textPulse")}}<i class="fa-solid fa-heart-pulse pfx-badge" title="Text Pulse"></i>{{/if}}
              {{#if (eq b.type "stopTextPulse")}}
                <span class="pfx-badge pfx-badge-stop" title="Stop Text Pulse">
                  <i class="fa-solid fa-font"></i>
                  <i class="fa-solid fa-pause pfx-badge-stop-pause"></i>
                </span>
              {{/if}}
              {{#if (eq b.type "stopIconSpin")}}
                <span class="pfx-badge pfx-badge-stop" title="Stop Icon Spin">
                  <img src="/ui/pause.svg" alt="">
                  <i class="fa-solid fa-pause pfx-badge-stop-pause"></i>
                </span>
              {{/if}}
              {{#if (eq b.type "stopBorderPulse")}}
                <span class="pfx-badge pfx-badge-stop" title="Stop Border Pulse">
                  <i class="fa-regular fa-square-full"></i>
                  <i class="fa-solid fa-pause pfx-badge-stop-pause"></i>
                </span>
              {{/if}}
              {{#if (eq b.type "stopAudio")}}<i class="fa-solid fa-volume-xmark pfx-badge" title="Stop Audio"></i>{{/if}}
              {{#if (eq b.type "unpause")}}<i class="fa-solid fa-circle-play pfx-badge" title="Unpause"></i>{{/if}}
            {{/each}}
          </span>
          <span class="pfx-step-text">{{row.text}}</span>
        </button>
        {{#unless (eq row.index 0)}}
        <button type="button" class="pfx-step-remove" data-index="{{row.index}}"
                title="Click to remove (confirms) -- hold ~1.4s to skip the confirmation">
          <i class="fa-solid fa-trash"></i>
        </button>
        {{/unless}}
      </li>
      {{/each}}
    </ol>
    <button type="button" data-action="addStep"><i class="fa-solid fa-plus"></i> Add Step</button>
  </fieldset>
</div>
