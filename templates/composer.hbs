<div class="pfx-composer">
  <fieldset class="pfx-startup">
    <legend>Startup</legend>
    <label>Pulse Length (s)
      <input type="number" step="0.01" min="0" name="pulseLengthS" placeholder="3.64" value="{{globals.pulseLengthS}}">
    </label>
    <label class="pfx-checkbox"><input type="checkbox" name="endCombat" {{checked globals.endCombat}}> End active combat</label>
    <div class="pfx-close-windows">
      <span>Close all windows for:</span>
      <label class="pfx-checkbox"><input type="checkbox" name="closeWindowsPlayers" {{checked globals.closeWindowsPlayers}}> Players</label>
      <label class="pfx-checkbox"><input type="checkbox" name="closeWindowsGM" {{checked globals.closeWindowsGM}}> GM</label>
    </div>
  </fieldset>

  <fieldset class="pfx-presets">
    <legend>Presets</legend>
    <select data-role="preset-select">
      <option value="">-- load a saved preset --</option>
      {{#each presetNames as |name|}}<option value="{{name}}">{{name}}</option>{{/each}}
    </select>
    <button type="button" data-action="deletePreset" title="Delete the selected preset">
      <i class="fa-solid fa-trash"></i>
    </button>
    <input type="text" name="presetName" placeholder="preset name..." value="{{globals.presetName}}">
    <button type="button" data-action="savePreset">
      <i class="fa-solid fa-floppy-disk"></i> Save as preset
    </button>
  </fieldset>

  <fieldset class="pfx-steps-fieldset">
    <legend>Steps</legend>

    <!-- Always first, no handle/trash -- the look-and-feel fields that used to be their own
         "Look & feel" section, now presented the same way a real step is (so there's only
         one field-editing pattern to learn), just pinned and unremovable. Doesn't literally
         say "Step 0" anywhere -- its position alone says what it is. -->
    <div class="pfx-step pfx-step-pinned">
      <details class="pfx-step-details">
        <summary>{{startupSummaryText}}</summary>
        <div class="pfx-step-fields">
          <label>Icon
            <span class="pfx-with-picker">
              <input type="text" name="icon" placeholder="curtain-call/art/eye.gif" value="{{globals.icon}}">
              <button type="button" data-action="browseFile" data-for="icon" data-picker-type="imagevideo">
                <i class="fa-solid fa-folder-open"></i>
              </button>
            </span>
          </label>
          <label>Icon glow <input type="text" name="iconGlow" placeholder="red" value="{{globals.iconGlow}}"></label>
          <label>Border color <input type="text" name="borderColor" placeholder="red" value="{{globals.borderColor}}"></label>
          <label>Initial text <input type="text" name="text" value="{{globals.text}}"></label>
        </div>
      </details>
    </div>

    <ol class="pfx-steps">
      {{#each rows as |row|}}
      <li class="pfx-step" data-index="{{row.index}}">
        <i class="pfx-step-handle fa-solid fa-grip-vertical" draggable="true" title="Drag to reorder"></i>
        <details class="pfx-step-details">
          <summary>{{row.summary}}</summary>
          <div class="pfx-step-fields">
            <label>Wait (pulses)
              <input type="number" step="0.05" min="0" data-index="{{row.index}}" data-field="waitUnits" value="{{row.waitUnits}}">
            </label>
            <label class="pfx-checkbox">
              <input type="checkbox" data-index="{{row.index}}" data-field="waitForVideoEnd" {{checked row.waitForVideoEnd}}>
              wait for video end (ignores the wait above)
            </label>

            <label>Text <input type="text" data-index="{{row.index}}" data-field="text" value="{{row.text}}"></label>
            <label class="pfx-checkbox">
              <input type="checkbox" data-index="{{row.index}}" data-field="blankText" {{checked row.blankText}}> blank text
            </label>
            <label class="pfx-checkbox">
              <input type="checkbox" data-index="{{row.index}}" data-field="freeze" {{checked row.freeze}}> freeze
            </label>
            <label class="pfx-checkbox">
              <input type="checkbox" data-index="{{row.index}}" data-field="resume" {{checked row.resume}}> resume
            </label>
            <label class="pfx-checkbox">
              <input type="checkbox" data-index="{{row.index}}" data-field="hideIcon" {{checked row.hideIcon}}> hide icon
            </label>
            <label class="pfx-checkbox">
              <input type="checkbox" data-index="{{row.index}}" data-field="showIcon" {{checked row.showIcon}}> show icon
            </label>

            <label>Audio <input type="text" data-index="{{row.index}}" data-field="audio" value="{{row.audio}}"></label>
            <label>Audio volume
              <input type="number" step="0.1" min="0" max="1" data-index="{{row.index}}" data-field="audioVolume" value="{{row.audioVolume}}">
            </label>

            <label>Media
              <select data-index="{{row.index}}" data-field="mediaType">
                <option value="none" {{#if (eq row.mediaType "none")}}selected{{/if}}>none</option>
                <option value="video" {{#if (eq row.mediaType "video")}}selected{{/if}}>video</option>
                <option value="image" {{#if (eq row.mediaType "image")}}selected{{/if}}>image</option>
              </select>
            </label>
            <label>Media path <input type="text" data-index="{{row.index}}" data-field="mediaPath" value="{{row.mediaPath}}"></label>
            <label>Video volume
              <input type="number" step="0.1" min="0" max="1" data-index="{{row.index}}" data-field="videoVolume" value="{{row.videoVolume}}">
            </label>
            <label class="pfx-checkbox">
              <input type="checkbox" data-index="{{row.index}}" data-field="closeVideo" {{checked row.closeVideo}}> close video/image
            </label>

            <label>Run macro
              <select data-index="{{row.index}}" data-field="macro">
                <option value="">-- none --</option>
                {{#each ../macroNames as |name|}}
                  <option value="{{name}}" {{#if (eq name row.macro)}}selected{{/if}}>{{name}}</option>
                {{/each}}
              </select>
            </label>
          </div>
        </details>
        <button type="button" class="pfx-step-remove" data-index="{{row.index}}"
                title="Click to remove (confirms) -- hold ~1.4s to skip the confirmation">
          <i class="fa-solid fa-trash"></i>
        </button>
      </li>
      {{else}}
      <li class="pfx-steps-empty">No steps yet -- add one below.</li>
      {{/each}}
    </ol>
    <button type="button" data-action="addStep"><i class="fa-solid fa-plus"></i> Add step</button>
  </fieldset>

  <button type="button" data-action="run" class="pfx-run">
    <i class="fa-solid fa-play"></i> Run
  </button>
</div>
